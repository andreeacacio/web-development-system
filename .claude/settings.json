{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/*-credentials.json)",
      "Read(**/secrets/**)",
      "Read(**/.secrets/**)",
      "Read(**/*.tfvars)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.config/gh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ecdsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/credentials.json)",
      "Edit(**/service-account*.json)",
      "Edit(**/*-credentials.json)",
      "Edit(**/secrets/**)",
      "Edit(**/.secrets/**)",
      "Edit(**/*.tfvars)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.npmrc)",
      "Edit(~/.config/gh/**)",
      "Edit(.claude/settings.json)"
    ]
  }
}
