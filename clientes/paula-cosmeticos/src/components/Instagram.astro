---
import Icon from './Icon.astro';
import { site } from '../data/site';
const tiles = [1, 2, 3, 4, 5, 6];
---
<section class="section insta" id="instagram" aria-labelledby="insta-title">
  <div class="wrap">
    <div class="head insta__head" data-reveal>
      <p class="eyebrow">Instagram</p>
      <h2 id="insta-title" class="title">{site.instagram.user ? <a href={site.instagram.url} target="_blank" rel="noopener">@{site.instagram.user}</a> : <>Acompanhe nas <em>redes</em></>}</h2>
      <p class="lead">Novidades, dicas e lançamentos acontecem por lá. Acompanhe e fique por dentro.</p>
    </div>

    <ul class="insta__grid" role="list">
      {tiles.map((n, i) => (
        <li data-reveal style={`--d:${(i % 3) * 0.08}s`}>
          <a href={site.instagram.url || undefined} target="_blank" rel="noopener" aria-label={`Ver publicação ${n} no Instagram`}>
            <img src={`/images/insta-${n}.svg`} alt="" width="800" height="800" loading="lazy" decoding="async" />
            <span class="insta__over"><Icon name="instagram" /></span>
          </a>
        </li>
      ))}
    </ul>

    <div class="insta__foot">
      {site.instagram.url && <a class="btn btn--ghost" href={site.instagram.url} target="_blank" rel="noopener"><Icon name="instagram" /> Seguir no Instagram</a>}
      <span class="note">Prévias ilustrativas · perfil do Instagram a confirmar</span>
    </div>
  </div>
</section>

<style>
  .insta__head { justify-items: center; text-align: center; }
  .insta__head .lead { margin-inline: auto; }
  .insta__head a { text-decoration: none; font-style: italic; color: var(--rose-deep); overflow-wrap: anywhere; }
  .insta__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
  .insta__grid a { position: relative; display: block; aspect-ratio: 1; overflow: hidden; }
  .insta__grid img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .insta__over { position: absolute; inset: 0; display: grid; place-items: center; color: var(--ivory); background: rgb(63 42 45 / 0.35); opacity: 0; transition: opacity 0.5s var(--ease); }
  .insta__over :global(svg) { width: 2rem; height: 2rem; }
  .insta__grid a:hover img { transform: scale(1.06); }
  .insta__grid a:hover .insta__over, .insta__grid a:focus-visible .insta__over { opacity: 1; }
  .insta__foot { display: flex; flex-direction: column; align-items: center; gap: 1rem; margin-top: 2.5rem; text-align: center; }
  @media (min-width: 760px) { .insta__grid { grid-template-columns: repeat(3, 1fr); gap: 0.75rem; } }
  @media (min-width: 1100px) { .insta__grid { grid-template-columns: repeat(6, 1fr); } }
</style>
