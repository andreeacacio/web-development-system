---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, fullAddress, contactUrl } from '../data/site';
---
<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <Logo tone="light" height="4.2rem" />
      <p>{fullAddress}</p>
    </div>
    <ul class="footer__links" role="list">
      {site.instagram.url && <li><a class="link" href={site.instagram.url} target="_blank" rel="noopener"><Icon name="instagram" /> @{site.instagram.user}</a></li>}
      <li><a class="link" href={contactUrl} target="_blank" rel="noopener">Fale conosco</a></li>
      <li><a class="link" href="#topo">Voltar ao topo</a></li>
    </ul>
  </div>
  <div class="wrap footer__legal">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p>Protótipo demonstrativo · textos, imagens e dados provisórios</p>
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: rgb(251 247 242 / 0.78); padding-block: 4rem 2rem; }
  .footer__grid { display: grid; gap: 2.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid rgb(251 247 242 / 0.14); }
  .footer__brand { display: grid; gap: 1.2rem; justify-items: start; }
  .footer__brand p { font-size: 0.9rem; max-width: 22rem; }
  .footer__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .footer__links .link { color: var(--ivory); }
  .footer__links :global(svg) { width: 1rem; height: 1rem; }
  .footer__legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; padding-top: 1.5rem; font-size: 0.78rem; }
  @media (min-width: 760px) { .footer__grid { grid-template-columns: 1fr auto; align-items: end; } }
</style>
