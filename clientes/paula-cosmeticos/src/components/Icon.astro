---
// Ícones de traço fino, inline (sem dependências).
interface Props { name: 'instagram' | 'whatsapp' | 'arrow' | 'pin' | 'clock' | 'message' | 'menu' | 'close'; }
const { name } = Astro.props;
const paths: Record<Props['name'], string> = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="0.6" fill="currentColor"/>',
  whatsapp: '<path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z"/><path d="M9 8.6c.2-.6.6-.6 1-.6l.6.1 1 2.2-.6.9c.6 1.2 1.6 2.2 2.8 2.8l.9-.6 2.2 1c0 .7-.4 1.5-1.4 1.7-2.6.4-6.9-3.5-6.5-6.4"/>',
  arrow: '<path d="M4 12h15M14 6.5l5.5 5.5-5.5 5.5"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.4A7 7 0 0 1 19 9.6C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.6" r="2.4"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  message: '<path d="M4 5h16v11H9l-5 4z"/>',
  menu: '<path d="M4 8h16M4 16h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
};
---
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={paths[name]} />
