---
import { featured, contactUrl } from '../data/site';
---
<section class="section feat" id="destaques" aria-labelledby="feat-title">
  <div class="wrap">
    <div class="head feat__head" data-reveal>
      <p class="eyebrow">Destaques</p>
      <h2 id="feat-title" class="title">Escolhas <em>do momento</em></h2>
      <p class="lead">Uma vitrine para apresentar os produtos que a loja quer destacar a cada estação.</p>
    </div>

    <ul class="feat__grid" role="list">
      {featured.map((p, i) => (
        <li class="prod" data-reveal style={`--d:${i * 0.1}s`}>
          <div class="prod__img"><img src={p.image} alt={`Imagem ilustrativa de ${p.type.toLowerCase()}`} width="800" height="800" loading="lazy" decoding="async" /></div>
          <p class="prod__cat">{p.category}</p>
          <h3 class="prod__name">{p.type}</h3>
          <a class="link" href={contactUrl} target="_blank" rel="noopener" aria-label={`Consultar disponibilidade: ${p.type}`}>Consultar disponibilidade</a>
        </li>
      ))}
    </ul>
    <p class="feat__foot"><span class="note">Vitrine ilustrativa · produtos e imagens reais definidos pela loja</span></p>
  </div>
</section>

<style>
  .feat { background: transparent; }
  .feat__head { justify-items: center; text-align: center; }
  .feat__head .lead { margin-inline: auto; }
  .feat__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 1rem; }
  .prod { display: grid; gap: 0.35rem; justify-items: start; align-content: start; background: rgb(250 245 239 / 0.9); padding: 1rem 1rem 1.2rem; border-radius: var(--radius); }
  .prod__img { width: 100%; aspect-ratio: 1; overflow: hidden; border-radius: 50% 50% var(--radius) var(--radius) / 38% 38% var(--radius) var(--radius); background: var(--nude); margin-bottom: 0.8rem; }
  .prod__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease); }
  .prod:hover .prod__img img { transform: scale(1.06); }
  .prod__cat { font-size: 0.68rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--rose-deep); }
  .prod__name { font-size: 1.55rem; }
  .prod .link { font-size: 0.66rem; color: var(--ink-soft); }
  .feat__foot { text-align: center; margin-top: 3rem; }
  @media (min-width: 960px) {
    .feat__grid { grid-template-columns: repeat(4, 1fr); gap: 2rem; }
    .prod:nth-child(even) { margin-top: 3rem; }
  }
</style>
