---
import Icon from './Icon.astro';
import { categories, contactUrl } from '../data/site';
---
<section class="section cats" id="categorias" aria-labelledby="cats-title">
  <div class="wrap">
    <div class="head cats__head">
      <div class="head" data-reveal style="margin:0">
        <p class="eyebrow">Categorias</p>
        <h2 id="cats-title" class="title">Tudo para a sua <em>rotina de beleza</em></h2>
      </div>
      <p class="lead" data-reveal style="--d:0.15s">
        Do cuidado diário aos detalhes especiais. Escolha uma categoria e fale com a gente para conhecer as opções disponíveis.
      </p>
    </div>
  </div>

  <ul class="cats__list wrap" role="list">
    {categories.map((c, i) => (
      <li data-reveal style={`--d:${(i % 3) * 0.1}s`}>
        <a class="cat" href={contactUrl} target="_blank" rel="noopener" aria-label={`Consultar ${c.name}`}>
          <span class="cat__img"><img src={c.image} alt="" width="800" height="1000" loading="lazy" decoding="async" /></span>
          <span class="cat__body">
            <span class="cat__index">{String(i + 1).padStart(2, '0')}</span>
            <span class="cat__name">{c.name}</span>
            <span class="cat__note">{c.note}</span>
          </span>
          <span class="cat__go"><Icon name="arrow" /></span>
        </a>
      </li>
    ))}
  </ul>
  <p class="wrap cats__foot"><span class="note">Categorias sugeridas · imagens ilustrativas</span></p>
</section>

<style>
  .cats__head { margin-bottom: 0; }
  .cats__list {
    list-style: none; margin: clamp(2.5rem, 6vw, 4rem) auto 0; padding-block: 0 1rem;
    display: grid; grid-auto-flow: column; grid-auto-columns: min(72%, 18rem); gap: 1rem;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    scroll-padding-inline: var(--gutter);
  }
  .cats__list::-webkit-scrollbar { display: none; }
  .cats__list li { scroll-snap-align: start; }

  .cat { position: relative; display: block; text-decoration: none; color: var(--ink); }
  .cat__img { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--nude); border-radius: var(--radius); }
  .cat__img img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.18); transition: transform 1.4s var(--ease); }
  .cat:hover .cat__img img { transform: scale(1.26); }
  .cat__body { display: grid; grid-template-columns: auto 1fr; column-gap: 0.9rem; align-items: baseline; padding: 0.9rem 1rem; background: rgb(250 245 239 / 0.9); border-radius: var(--radius); }
  .cat__index { font-size: 0.7rem; letter-spacing: 0.2em; color: var(--rose-deep); grid-row: span 2; }
  .cat__name { font-family: var(--serif); font-size: 1.75rem; line-height: 1.1; }
  .cat__note { font-size: 0.86rem; color: var(--ink-soft); }
  .cat__go {
    position: absolute; top: 1rem; right: 1rem; display: grid; place-items: center;
    width: 2.6rem; height: 2.6rem; border-radius: 50%; background: rgb(251 247 242 / 0.85);
    opacity: 0; transform: translateY(6px) rotate(-45deg); transition: 0.6s var(--ease);
  }
  .cat__go :global(svg) { width: 1.1rem; height: 1.1rem; }
  .cat:hover .cat__go, .cat:focus-visible .cat__go { opacity: 1; transform: rotate(-45deg); }
  .cats__foot { margin-top: 1.5rem; }

  @media (min-width: 760px) {
    .cats__head { grid-template-columns: 1.2fr 1fr; align-items: end; gap: 3rem; }
    .cats__list { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); gap: clamp(1.25rem, 2.5vw, 2rem); row-gap: 3rem; overflow: visible; }
  }
</style>
