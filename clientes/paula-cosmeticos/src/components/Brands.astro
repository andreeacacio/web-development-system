---
import Icon from './Icon.astro';
import { brandGroups } from '../data/brands';
---
<section class="section brands" id="marcas" aria-labelledby="brands-title">
  <div class="wrap">
    <div class="head brands__head" data-reveal>
      <p class="eyebrow">Marcas</p>
      <h2 id="brands-title" class="title">Marcas que <em>trabalhamos</em></h2>
      <p class="lead">Perfumaria, cosméticos e acessórios de marcas conhecidas, selecionados para a sua rotina de beleza.</p>
    </div>

    {brandGroups.map((group, gi) => (
      <div class="brands__group" data-reveal>
        <h3 class="brands__group-title">{group.title}</h3>
        <ul class="brands__grid" role="list">
          {group.brands.map((b, i) => (
            <li class="card" style={`--d:${(i % 4) * 0.08}s`}>
              <div class:list={["card__media", b.dark && "card__media--dark"]}>
                {b.image ? (
                  <img src={b.image} alt={b.alt ?? `${b.kind === 'logo' ? 'Logotipo oficial' : 'Produto oficial'} ${b.name}`} width="600" height="600" loading="lazy" decoding="async" class:list={[b.source === 'revenda' && 'is-resale']} />
                ) : (
                  <div class="card__placeholder" role="img" aria-label={`Espaço reservado: ${b.kind === 'logo' ? 'logotipo' : 'imagem do produto'} oficial da marca ${b.name} ainda não enviado`}>
                    <span class="card__ph-icon" aria-hidden="true">
                      <Icon name="message" />
                    </span>
                    <span class="card__ph-text">{b.kind === 'logo' ? 'Logotipo' : 'Imagem do produto'} a enviar</span>
                  </div>
                )}
                {b.source === 'revenda' && <span class="card__badge">Foto de revenda</span>}
              </div>
              <div class="card__body">
                <p class="card__segment">{b.segment}</p>
                <h4 class="card__name">{b.name}</h4>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <p class="brands__foot"><span class="note">Logotipos oficiais · fotos de revenda identificadas · espaços reservados onde ainda não há material confiável</span></p>
  </div>
</section>

<style>
  .brands__head { justify-items: center; text-align: center; }
  .brands__head .lead { margin-inline: auto; }
  .brands__group { margin-top: clamp(3rem, 7vw, 5rem); }
  .brands__group-title {
    font-family: var(--sans); font-weight: 450; font-size: 0.74rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--rose-deep); display: flex; align-items: center; gap: 1rem; margin-bottom: 1.6rem;
  }
  .brands__group-title::after { content: ''; flex: 1; height: 1px; background: var(--line); }

  .brands__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem 0.9rem; }
  .card { display: grid; gap: 0.8rem; background: rgb(250 245 239 / 0.9); padding: 0.8rem; border-radius: var(--radius); }
  .card__media {
    position: relative; aspect-ratio: 1; overflow: hidden; border-radius: var(--radius);
    background: linear-gradient(160deg, var(--ivory-2), var(--nude)); border: 1px solid var(--line);
    display: grid; place-items: center;
    transition: transform 0.7s var(--ease), box-shadow 0.7s var(--ease), border-color 0.7s var(--ease);
  }
  .card__media--dark { background: var(--ink); border-color: var(--ink); }
  .card__media--dark img { padding: 18%; }
  .card__media img { width: 100%; height: 100%; object-fit: contain; padding: 12%; transition: transform 1s var(--ease); }
  .card__placeholder { display: grid; justify-items: center; gap: 0.6rem; padding: 1rem; text-align: center; color: var(--ink-soft); }
  .card__ph-icon { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; border: 1px dashed rgb(63 42 45 / 0.35); }
  .card__ph-icon :global(svg) { width: 1.1rem; height: 1.1rem; }
  .card__ph-text { font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; line-height: 1.5; }

  .card__body { display: grid; gap: 0.2rem; }
  .card__badge { position: absolute; left: 0.6rem; bottom: 0.6rem; font-size: 0.56rem; letter-spacing: 0.14em; text-transform: uppercase; background: rgb(250 245 239 / 0.92); color: var(--ink); padding: 0.3rem 0.5rem; border-radius: 999px; }
  .card__media img.is-resale { mix-blend-mode: multiply; padding: 6%; }
  .card__segment { font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-soft); }
  .card__name { font-family: var(--serif); font-weight: 500; font-size: clamp(1.3rem, 2.4vw, 1.7rem); line-height: 1.1; }

  @media (hover: hover) and (pointer: fine) {
    .card:hover .card__media { transform: translateY(-6px); box-shadow: 0 18px 40px -18px rgb(63 42 45 / 0.35); border-color: var(--rose); }
    .card:hover .card__media img { transform: scale(1.06); }
  }
  .brands__foot { text-align: center; margin-top: 3rem; }

  @media (min-width: 640px) { .brands__grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }
  @media (min-width: 1024px) { .brands__grid { grid-template-columns: repeat(5, 1fr); gap: 1.75rem; } }
</style>
