# ==========================================================
# web-development-system — .gitignore
# Padrão para projetos Astro, Next.js e pnpm (Cloud First)
# ==========================================================

# ---------- Segredos e credenciais (NUNCA versionar) ----------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*
credentials.json
service-account*.json
*-credentials.json
secrets/
.secrets/
*.tfvars

# ---------- Dependências ----------
node_modules/
.pnpm-store/
.pnpm-debug.log*

# ---------- Builds e caches de framework ----------
dist/
build/
out/
.astro/
.next/
.turbo/
.cache/
.vercel/
.netlify/
*.tsbuildinfo
next-env.d.ts

# ---------- Testes ----------
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Claude Code: configurações pessoais ----------
.claude/settings.local.json
CLAUDE.local.md

# ---------- Sistema operacional e editores ----------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
